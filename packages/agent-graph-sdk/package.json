{
  "name": "@bstockwelldev/agent-graph-sdk",
  "version": "0.1.0",
  "description": "Types, API client, and graph schema helpers for Agent Graph Builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "msw": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
