{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "studio": {
      "root": "apps/studio/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,**/__pycache__/**,**/*.pyc}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "studio" } }
  ],
  "env": {
    "GRAPH_DB_PATH": "/tmp/graphs.db",
    "CHAT_PROVIDER": "stub"
  }
}
