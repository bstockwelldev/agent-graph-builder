# Copy to backend/.env for local overrides, or rely on tabletop-studio/.env.local
# via BSTOCKWELL_DEV_ROOT (see README).

# Optional: explicit dotenv file (wins over BSTOCKWELL_DEV_ROOT lookup)
# SHARED_ENV_FILE=<dev-root>/tabletop-studio/.env.local

# Polyrepo root — when set, loads <dev-root>/tabletop-studio/.env.local on startup
# if the file exists (same keys as tabletop-studio env.template).
# BSTOCKWELL_DEV_ROOT=

# Per-run provider default when POST /api/runs omits provider (also accepts AI_PROVIDER)
# CHAT_PROVIDER=stub

# tabletop-studio AI keys (loaded from shared .env.local or set here)
# GROQ_API_KEY=
# GOOGLE_GENAI_API_KEY=
# GOOGLE_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible (OpenAI, LM Studio, Azure OpenAI via compat URL, etc.)
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_DEFAULT_MODEL=gpt-4o-mini

# Azure OpenAI (dedicated adapter — deployment id is the effective model)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# SQLite path (Docker sets /data/graphs.db; Vercel uses /tmp/graphs.db)
# GRAPH_DB_PATH=

# Vercel Blob. Injected by `vercel blob create-store`. Takes precedence over every
# other backend when set. Hobby limits (2k advanced / 10k simple ops per month)
# are easy to exhaust with list-heavy screens; exceeding them locks the store
# for 30 days. Prod uses Supabase Storage instead (below).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Supabase Storage (prod backend). Private bucket; service-role key is server-only.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=agent-graph-builder

# S3-compatible object store (alternative to Blob).
# Set bucket + both keys. Endpoint empty = AWS default; R2/MinIO/Azure S3 need a URL.
# OBJECT_STORE_BUCKET=
# OBJECT_STORE_ENDPOINT=
# OBJECT_STORE_ACCESS_KEY_ID=
# OBJECT_STORE_SECRET_ACCESS_KEY=
# OBJECT_STORE_REGION=

# Turso / libSQL (optional; ignored when Blob or OBJECT_STORE_* is set)
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=
